<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/vector_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        android:elevation="4dp">
        <HorizontalScrollView
            android:id="@+id/layer_button_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!--
                  One button per WifiDB history bucket. The tag is the bucket name and is
                  the only thing that identifies the layer: it names the published archive,
                  the source added at runtime, and the vector layer inside that archive.
                -->
                <Button
                    android:id="@+id/btn_daily"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="daily"
                    android:text="Show Day"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_weekly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="weekly"
                    android:text="Show Week"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_monthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="monthly"
                    android:text="Show Month"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_0to1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="0to1year"
                    android:text="Show 0-1 year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_1to2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="1to2year"
                    android:text="Show 1-2 year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_2to3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="2to3year"
                    android:text="Show 2-3 year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_3to5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="3to5year"
                    android:text="Show 3-5 year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_5to10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="5to10year"
                    android:text="Show 5-10 year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_10plus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="10yrplus"
                    android:text="Show 10+ year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_cell_daily"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="cell_daily"
                    android:text="Show Cell Day"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_cell_weekly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="cell_weekly"
                    android:text="Show Cell Week"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_cell_monthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="cell_monthly"
                    android:text="Show Cell Month"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_cell_0to1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="cell_0to1year"
                    android:text="Show Cell 0-1 year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_cell_1to2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="cell_1to2year"
                    android:text="Show Cell 1-2 year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_cell_2to3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="cell_2to3year"
                    android:text="Show Cell 2-3 year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_cell_3to5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="cell_3to5year"
                    android:text="Show Cell 3-5 year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_cell_5to10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="cell_5to10year"
                    android:text="Show Cell 5-10 year"
                    android:onClick="toggleLayerClick" />
                <Button
                    android:id="@+id/btn_cell_10plus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="cell_10yrplus"
                    android:text="Show Cell 10+ year"
                    android:onClick="toggleLayerClick" />
            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Location tracking FAB: cycles OFF -> SHOW -> TRACK -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_locate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/locate"
        android:src="@android:drawable/ic_menu_mylocation"
        android:tint="@android:color/white"
        android:layout_gravity="bottom|end" />

    <!-- Bearing mode FAB: cycles NORTH -> COMPASS -> GPS -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_bearing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:contentDescription="Bearing mode"
        android:src="@drawable/ic_compass_diamond"
        android:tint="@android:color/white"
        android:layout_gravity="bottom|end" />

    <!-- Attribution/info button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Map attribution"
        android:src="@android:drawable/ic_dialog_info"
        android:tint="@android:color/white"
        app:fabSize="mini"
        app:backgroundTint="#80000000"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_gravity="bottom|start" />

</FrameLayout>
